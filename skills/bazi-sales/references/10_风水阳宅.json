      {"element": "木", "orientation": "东方", "color": "绿色", "meaning": "木属东方，宜朝东或卧室东方", "data_source": "bazi_result.json → day_master.element === '木'"},
      {"element": "火", "orientation": "南方", "color": "红色", "meaning": "火属南方，宜朝南或采光南方", "data_source": "bazi_result.json → day_master.element === '火'"},
      {"element": "土", "orientation": "中央", "color": "黄色", "meaning": "土属中央，宜中心布局均衡", "data_source": "bazi_result.json → day_master.element === '土'"},
      {"element": "金", "orientation": "西方", "color": "白色/金色", "meaning": "金属西方，宜朝西或西方布局", "data_source": "bazi_result.json → day_master.element === '金'"},
      {"element": "水", "orientation": "北方", "color": "蓝色/黑色", "meaning": "水属北方，宜朝北或北方有水", "data_source": "bazi_result.json → day_master.element === '水'"}
    ]
  },
  "section_2_house_selection_principle": {
    "title": "选房原则",
    "principle_1": {
      "rule": "根据日主五行选择房屋朝向",
      "meaning": "日主五行喜什么，房屋朝向就选什么方位",
      "data_source": "bazi_result.json → day_master.element + dynamics.body_strength"
    },
    "principle_2": {
      "rule": "避开与命局相克的方位",
      "meaning": "日主所克的五行对应方位要避免主卧",
      "data_source": "bazi_result.json → day_master.element (opposite element)"
    },
    "principle_3": {
      "rule": "考虑采光和通风",
      "meaning": "结合日主冷暖属性选择采光程度",
      "data_source": "bazi_result.json → day_master.element"
    }
  },
  "section_3_interior_layout": {
    "title": "室内布局建议",
    "living_room": "客厅宜明亮，选择中性色调搭配日主五行色",
